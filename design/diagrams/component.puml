@startuml component
title Wire Encoder Modbus Interface — Firmware Component Diagram (as built)

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #14746F
skinparam component {
  BackgroundColor #F5F7F7
  BorderColor #5B6B6A
}

' ---- external nodes ----
actor "Modbus master\n(RS-485)" as master
component "draw-wire encoder\n10 kΩ pot → PA2 (ADC ch0)" as enc #FFFFFF
component "end switches\nsupervised ladder → PC4 (ADC ch2)" as sw #FFFFFF

' ---- orchestration & platform (cross-cutting) ----
component "main\nzero-ISR super-loop" as main #EAEFEF
component "board\nIWDG · PVD · address jumper (PC1)" as board #EAEFEF

' ---- Modbus + register hub ----
component "mb\nModbus RTU driver (USART1/PD6)" as mb
component "regs\nregister image (hub)\n+ ladder band decode" as regs #DCEBE9

' ---- measurement pipeline ----
component "meas_open\nwindow · scale · fault\nwiper/ladder on ALTERNATE ticks" as mo
component "we\nowns the ADC:\nwiper burst + float detect,\nladder channel\n≥241-cycle sample (FR-E12)" as we

' ---- helpers / storage ----
component "avg\nboxcar mean + min/max" as avg
component "health\nFR-E23 stuck · FR-E24 band\nstatus bits 7 / 6" as health #DCEBE9
component "persist\nflash store · FR-S39" as persist

' ==== data flow (sensor → bus) ====
enc --> we   : wiper (ratiometric)
sw  --> we   : ladder level
we  --> mo   : raw code / validity\n+ ladder raw
mo  --> regs : publish_opening (30001–30005, 30012)\npublish_switches -> status bits 3/4
regs <--> mb : regs_cfg:\nholdings · input_read · FR-S31 + FR-E06
mb  <--> master : RTU frames\nFC03/04/06/16

' ==== helpers / storage ====
regs --> avg : add / read (mean, min, max)
mo --> health : window raw + switch state
health --> regs : status bits 6 / 7
regs <--> persist : load (boot) / save (FR-S39)

' ==== orchestration (control) ====
main ..> mb    : mb_poll (each loop)
main ..> regs  : service / persist_service
main ..> mo    : service
main ..> board : iwdg_feed / power_ok
board --> regs : latched mb_address

legend right
  solid = runtime data / calls
  dotted = control
  regs is the central register hub
  ONE ADC, two channels: wiper + switch ladder
  the two front-ends fault independently (FR-E16)
endlegend
@enduml
